# Required in Coolify Variables
DISCORD_TOKEN=

# Usable defaults. Change these for a real public deployment if desired.
ADMIN_USER=admin
ADMIN_PASSWORD=itsuka-admin-password
SESSION_SECRET_KEY=itsuka-session-secret-change-me-before-production
SERVICE_PASSWORD_POSTGRES=itsuka-postgres-password

# Public admin UI URL. ".space" is the top-level domain of usapo.space.
SERVICE_URL_FRONTEND_3000=https://itsuka.usapo.space
CORS_ORIGINS=https://itsuka.usapo.space

SECURE_COOKIE=true
LOG_LEVEL=INFO

POSTGRES_DB=itsuka_bot
POSTGRES_USER=itsuka

DB_MEMORY_LIMIT=256m
DB_CPUS=0.50
DB_SHM_SIZE=128mb
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS=32MB

BOT_MEMORY_LIMIT=384m
BOT_CPUS=0.75
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPUS=0.50
API_MEMORY_LIMIT=384m
API_CPUS=0.75
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPUS=1.00
