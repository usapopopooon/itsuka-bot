# Required in Coolify Variables
DISCORD_TOKEN=
ADMIN_PASSWORD=
SESSION_SECRET_KEY=

# Coolify can auto-generate this when the variable name starts with SERVICE_PASSWORD_.
SERVICE_PASSWORD_POSTGRES=

# Public admin UI URL. If Coolify generates SERVICE_URL_FRONTEND_3000,
# CORS_ORIGINS can be left unset.
SERVICE_URL_FRONTEND_3000=https://itsuka.usapo.space
CORS_ORIGINS=

# Optional
ADMIN_USER=admin
SECURE_COOKIE=true
LOG_LEVEL=INFO

POSTGRES_DB=itsuka_bot
POSTGRES_USER=itsuka

DB_MEMORY_LIMIT=256m
DB_CPUS=0.50
DB_SHM_SIZE=64mb
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS=64MB

BOT_MEMORY_LIMIT=384m
BOT_CPUS=0.75
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPUS=0.50
API_MEMORY_LIMIT=384m
API_CPUS=0.75
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPUS=1.00
