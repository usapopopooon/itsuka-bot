# Discord Developer Portal で取得した Bot トークン
DISCORD_TOKEN=your-bot-token-here

# データベース接続 URL
# ローカル開発 (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/itsuka.db
# Docker / 本番 (Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/itsuka_bot

# Web 管理画面の単一管理者
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# JWT 署名鍵 (未設定だと再起動でセッション失効。本番では必ず固定値を設定)
SESSION_SECRET_KEY=

# HTTPS 配信時のみ true (cookie の Secure 属性)
SECURE_COOKIE=false

# Next.js フロントの URL (CORS 許可リスト)
CORS_ORIGINS=http://localhost:3000

# uvicorn のバインド設定
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ログレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
